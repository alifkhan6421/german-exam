# Copy to .env.local. Every variable is optional in development: missing services run in a
# clearly labelled development mode (see docs/DEV_MODE.md). Set APP_ENV=production to refuse
# all development modes.

APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Postgres, Auth, Storage). All four are required to leave dev mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose
DATABASE_URL=                       # pooled connection string (Supavisor, transaction mode)

# --- Stripe Billing. Webhooks are the only way paid access is granted. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map plans to Stripe prices in Admin → Plans (stripe_price_id), not here.

# --- Anthropic (exam generation and provisional AI assessment) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_GENERATION_MODEL=claude-opus-5-5
LLM_ASSESSMENT_MODEL=claude-opus-5-5

# --- ElevenLabs (listening production and speaking transcription) ---
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# --- Scheduled jobs (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=

# --- Development only ---
DEV_DATA_DIR=.data
DEV_SESSION_SECRET=change-me
DEV_ALLOW_PREVIEW_AUDIO=true
